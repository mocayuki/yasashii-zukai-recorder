{
	"name": "yasashii-hub",
	"private": true,
	"version": "0.1.0",
	"description": "やさしい図解レコーダーの投稿ハブ（Cloudflare Worker）。X・Threads・Instagram・TikTok への投稿と予約を受け持つ",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --port 8787",
		"deploy": "wrangler deploy",
		"check": "tsc --noEmit",
		"db:local": "wrangler d1 migrations apply hub --local",
		"db:remote": "wrangler d1 migrations apply hub --remote"
	},
	"dependencies": {
		"hono": "^4.13.7"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260915.1",
		"typescript": "^5.7.0",
		"wrangler": "^4.0.0"
	}
}
